# Copy this file to .env, then replace the placeholders with your NTU network account.
NTU_USERNAME=your-network-username
NTU_PASSWORD=your-network-password

# Optional: personal academic-data cache lifetime in seconds (default: 300; 0 disables caching).
# NTU_PERSONAL_CACHE_TTL_SECONDS=300

# Optional NTULearn settings. Student email is derived from NTU_USERNAME.
# NTULEARN_CACHE_TTL_SECONDS=300
# NTULEARN_HEADLESS=true
